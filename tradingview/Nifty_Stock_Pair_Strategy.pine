// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=5
strategy("Nifty × Stock Pair Strategy", shorttitle="Nifty Pair Strat", overlay=false,
     initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.03, slippage=1,
     max_bars_back=5000, process_orders_on_close=true)

// =============================================================================
// Backtest companion to "Nifty × Stock Pair Trader Pro"
// Chart = stock. Pair Symbol = NSE:NIFTY (or sector index).
// NOTE: TV strategy PnL is on the CHART symbol only. Use it to validate Z timing;
// real pair PnL = stock leg + opposite index/futures leg.
// =============================================================================

grpCore    = "1) Pair Setup"
pairSym    = input.symbol("NSE:NIFTY", "Pair Symbol (Nifty / Index)", group=grpCore)
spreadMode = input.string("Residual (OLS)", "Spread Model", options=["Residual (OLS)", "Log Residual (OLS)", "Price Ratio", "Log Ratio"], group=grpCore)
betaMode   = input.string("Rolling OLS", "Hedge Ratio", options=["Rolling OLS", "Kalman Filter", "Fixed 1.0"], group=grpCore)
lookback   = input.int(60, "Lookback (bars)", minval=20, maxval=500, group=grpCore)

grpSig         = "2) Signals"
zEntry         = input.float(2.0, "Entry |Z|", minval=0.5, maxval=5.0, step=0.1, group=grpSig)
zExit          = input.float(0.5, "Exit |Z|",  minval=0.0, maxval=3.0, step=0.1, group=grpSig)
zStop          = input.float(3.5, "Stop |Z|",  minval=1.0, maxval=8.0, step=0.1, group=grpSig)
useCorrFilter  = input.bool(true, "Require Correlation Filter", group=grpSig)
minCorr        = input.float(0.70, "Min |Correlation|", minval=0.0, maxval=0.99, step=0.05, group=grpSig)

grpAdv   = "3) Advanced"
kalmanQ  = input.float(0.0001, "Kalman Q", minval=0.000001, maxval=0.01, step=0.0001, group=grpAdv)
kalmanR  = input.float(0.01, "Kalman R", minval=0.0001, maxval=1.0, step=0.001, group=grpAdv)

stockClose = close
pairClose  = request.security(pairSym, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)

useLog = str.contains(spreadMode, "Log")
stockPx = useLog ? math.log(math.max(stockClose, 1e-10)) : stockClose
pairPx  = useLog ? math.log(math.max(pairClose, 1e-10))  : pairClose

f_ols_beta(float y, float x, int len) =>
    meanY = ta.sma(y, len)
    meanX = ta.sma(x, len)
    covXY = ta.sma(y * x, len) - meanY * meanX
    varX  = ta.sma(x * x, len) - meanX * meanX
    varX > 1e-12 ? covXY / varX : 1.0

f_ols_alpha(float y, float x, float beta, int len) =>
    ta.sma(y, len) - beta * ta.sma(x, len)

olsBeta  = f_ols_beta(stockPx, pairPx, lookback)
olsAlpha = f_ols_alpha(stockPx, pairPx, olsBeta, lookback)

var float kfBeta = 1.0
var float kfP    = 1.0
if barstate.isfirst
    kfBeta := 1.0
    kfP    := 1.0
else
    betaPred = kfBeta
    pPred    = kfP + kalmanQ
    x = pairPx
    y = stockPx
    S = x * x * pPred + kalmanR
    K = S > 0 ? (pPred * x) / S : 0.0
    innov = y - betaPred * x
    kfBeta := betaPred + K * innov
    kfP    := (1.0 - K * x) * pPred

hedgeBeta  = betaMode == "Kalman Filter" ? kfBeta : betaMode == "Fixed 1.0" ? 1.0 : olsBeta
hedgeAlpha = betaMode == "Rolling OLS" ? olsAlpha : 0.0

spread = switch spreadMode
    "Residual (OLS)"     => stockClose - (hedgeAlpha + hedgeBeta * pairClose)
    "Log Residual (OLS)" => stockPx - (hedgeAlpha + hedgeBeta * pairPx)
    "Price Ratio"        => stockClose / math.max(pairClose, 1e-10)
    "Log Ratio"          => math.log(math.max(stockClose, 1e-10) / math.max(pairClose, 1e-10))
    => stockClose - hedgeBeta * pairClose

spreadMean = ta.sma(spread, lookback)
spreadStd  = ta.stdev(spread, lookback)
zScore     = spreadStd > 1e-12 ? (spread - spreadMean) / spreadStd : 0.0
corr       = ta.correlation(stockClose, pairClose, lookback)
corrOk     = not useCorrFilter or math.abs(corr) >= minCorr

longCond  = corrOk and zScore <= -zEntry
shortCond = corrOk and zScore >=  zEntry
exitLong  = zScore >= -zExit or zScore <= -zStop
exitShort = zScore <=  zExit or zScore >=  zStop

if longCond
    strategy.entry("LongPair", strategy.long)
if shortCond
    strategy.entry("ShortPair", strategy.short)
if strategy.position_size > 0 and exitLong
    strategy.close("LongPair")
if strategy.position_size < 0 and exitShort
    strategy.close("ShortPair")

plot(zScore, "Z-Score", color=color.new(#546e7a, 0), linewidth=2)
hline(zEntry,  "+Entry", color=color.new(#c62828, 40), linestyle=hline.style_dashed)
hline(-zEntry, "−Entry", color=color.new(#2e7d32, 40), linestyle=hline.style_dashed)
hline(0, "Zero", color=color.new(#90a4ae, 50))
bgcolor(strategy.position_size > 0 ? color.new(#2e7d32, 92) : strategy.position_size < 0 ? color.new(#c62828, 92) : na)

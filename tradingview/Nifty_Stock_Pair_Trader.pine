//@version=5
indicator("Nifty × Stock Pair Trader Pro", shorttitle="Nifty Pair Pro", overlay=false, max_bars_back=5000, precision=4)

// =============================================================================
// NIFTY × STOCK PAIR TRADER PRO  — EDGE PLAYBOOK (default)
// -----------------------------------------------------------------------------
// Defaults from backtest edge rules:
//   • LONG PAIR only (stock cheap vs Nifty)
//   • Enter: |Z| ≥ 2, |corr| ≥ 0.80, half-life ≤ 8 bars
//   • Exit TP: |Z| ≤ 0.5 | Stop: |Z| ≥ 4.0 | Time: 15 bars
//
// HOW YOU MONITOR A LIVE TRADE
//   Watch the on-chart DASHBOARD every day:
//     • Z-Score line + "TRADE STATUS" row tell you HOLD / TAKE PROFIT / STOP
//     • Bars Held vs Max Hold tell you when to time-exit
//   You do NOT need to calculate anything manually.
// =============================================================================

// ── Inputs ───────────────────────────────────────────────────────────────────
grpCore    = "1) Pair Setup"
pairSym    = input.symbol("NSE:NIFTY", "Pair Symbol (Nifty / Index)", group=grpCore)
spreadMode = input.string("Residual (OLS)", "Spread Model", options=["Residual (OLS)", "Log Residual (OLS)", "Price Ratio", "Log Ratio"], group=grpCore)
betaMode   = input.string("Rolling OLS", "Hedge Ratio", options=["Rolling OLS", "Kalman Filter", "Fixed 1.0"], group=grpCore)
lookback   = input.int(60, "Lookback (bars)", minval=20, maxval=500, group=grpCore)

grpPlay    = "2) Edge Playbook (recommended defaults)"
longOnly   = input.bool(true, "LONG PAIR only (skip shorts)", group=grpPlay, tooltip="Backtest edge was on LONG pairs. Keep ON.")
zEntry     = input.float(2.0, "Entry |Z|", minval=0.5, maxval=5.0, step=0.1, group=grpPlay)
zExit      = input.float(0.5, "Take-Profit |Z|", minval=0.0, maxval=3.0, step=0.1, group=grpPlay)
zStop      = input.float(4.0, "Stop |Z|", minval=1.0, maxval=8.0, step=0.1, group=grpPlay)
minCorr    = input.float(0.80, "Min |Correlation|", minval=0.0, maxval=0.99, step=0.05, group=grpPlay)
maxHalfLife = input.float(8.0, "Max Half-Life (bars)", minval=1.0, maxval=60.0, step=0.5, group=grpPlay)
maxHoldBars = input.int(15, "Max Hold (bars) — time exit", minval=3, maxval=60, group=grpPlay)
useHlFilter = input.bool(true, "Require Half-Life Filter", group=grpPlay)
alertOnConfirm = input.bool(true, "Alerts Need Bar Close", group=grpPlay)

grpAdv     = "3) Advanced"
kalmanQ    = input.float(0.0001, "Kalman Q", minval=0.000001, maxval=0.01, step=0.0001, group=grpAdv)
kalmanR    = input.float(0.01, "Kalman R", minval=0.0001, maxval=1.0, step=0.001, group=grpAdv)
useLogPrices = input.bool(false, "Force Log Prices for OLS/Kalman", group=grpAdv)

grpVis     = "4) Display"
showZPlot  = input.bool(true, "Show Z-Score", group=grpVis)
showDash   = input.bool(true, "Show Live Trade Dashboard", group=grpVis)
tablePos   = input.string("Top Right", "Dashboard Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=grpVis)

// ── Data ─────────────────────────────────────────────────────────────────────
stockClose = close
pairClose  = request.security(pairSym, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)

stockPx = useLogPrices or str.contains(spreadMode, "Log") ? math.log(math.max(stockClose, 1e-10)) : stockClose
pairPx  = useLogPrices or str.contains(spreadMode, "Log") ? math.log(math.max(pairClose, 1e-10))  : pairClose

f_ols_beta(float y, float x, int len) =>
    meanY = ta.sma(y, len)
    meanX = ta.sma(x, len)
    covXY = ta.sma(y * x, len) - meanY * meanX
    varX  = ta.sma(x * x, len) - meanX * meanX
    varX > 1e-12 ? covXY / varX : 1.0

f_ols_alpha(float y, float x, float beta, int len) =>
    ta.sma(y, len) - beta * ta.sma(x, len)

olsBeta  = f_ols_beta(stockPx, pairPx, lookback)
olsAlpha = f_ols_alpha(stockPx, pairPx, olsBeta, lookback)

var float kfBeta = 1.0
var float kfP    = 1.0
if barstate.isfirst
    kfBeta := 1.0
    kfP    := 1.0
else
    betaPred = kfBeta
    pPred    = kfP + kalmanQ
    x = pairPx
    y = stockPx
    S = x * x * pPred + kalmanR
    K = S > 0 ? (pPred * x) / S : 0.0
    innov = y - betaPred * x
    kfBeta := betaPred + K * innov
    kfP    := (1.0 - K * x) * pPred

hedgeBeta  = betaMode == "Kalman Filter" ? kfBeta : betaMode == "Fixed 1.0" ? 1.0 : olsBeta
hedgeAlpha = betaMode == "Rolling OLS" ? olsAlpha : 0.0

spread = switch spreadMode
    "Residual (OLS)"     => stockClose - (hedgeAlpha + hedgeBeta * pairClose)
    "Log Residual (OLS)" => stockPx - (hedgeAlpha + hedgeBeta * pairPx)
    "Price Ratio"        => stockClose / math.max(pairClose, 1e-10)
    "Log Ratio"          => math.log(math.max(stockClose, 1e-10) / math.max(pairClose, 1e-10))
    => stockClose - hedgeBeta * pairClose

spreadMean = ta.sma(spread, lookback)
spreadStd  = ta.stdev(spread, lookback)
zScore     = spreadStd > 1e-12 ? (spread - spreadMean) / spreadStd : 0.0

corr = ta.correlation(stockClose, pairClose, lookback)
corrOk = math.abs(corr) >= minCorr

f_half_life(float spr, float mean, int len) =>
    float ySum = 0.0
    float xSum = 0.0
    float xxSum = 0.0
    float xySum = 0.0
    int n = 0
    for i = 0 to len - 2
        float x = spr[i + 1] - mean
        float y = spr[i] - mean
        xSum  += x
        ySum  += y
        xxSum += x * x
        xySum += x * y
        n += 1
    float denom = n * xxSum - xSum * xSum
    float phi = denom != 0 ? (n * xySum - xSum * ySum) / denom : 0.0
    (phi > 0 and phi < 1) ? -math.log(2.0) / math.log(phi) : na

halfLife = f_half_life(spread, spreadMean, lookback)
hlOk = not useHlFilter or (not na(halfLife) and halfLife > 0 and halfLife <= maxHalfLife)

// Entry checklist (all must be PASS for a valid signal)
zLongOk  = zScore <= -zEntry
zShortOk = zScore >=  zEntry
entryFiltersOk = corrOk and hlOk

// ── Position state + bars held ───────────────────────────────────────────────
var int pos = 0
var int entryBar = na
var float entryZ = na
var float entryBeta = na

canEnterLong  = longOnly ? true : true
canEnterShort = not longOnly

enterLong  = entryFiltersOk and zLongOk  and pos <= 0 and canEnterLong
enterShort = entryFiltersOk and zShortOk and pos >= 0 and canEnterShort and not longOnly

barsHeld = pos != 0 and not na(entryBar) ? bar_index - entryBar : 0
timeExit = pos != 0 and barsHeld >= maxHoldBars

// While in LONG: TP when Z rises back to -zExit; stop when Z falls to -zStop
exitLongTP   = pos == 1 and zScore >= -zExit
exitLongStop = pos == 1 and zScore <= -zStop
exitShortTP  = pos == -1 and zScore <=  zExit
exitShortStop = pos == -1 and zScore >=  zStop
exitLong  = exitLongTP or exitLongStop or (pos == 1 and timeExit)
exitShort = exitShortTP or exitShortStop or (pos == -1 and timeExit)

if enterLong
    pos := 1
    entryBar := bar_index
    entryZ := zScore
    entryBeta := hedgeBeta
else if enterShort
    pos := -1
    entryBar := bar_index
    entryZ := zScore
    entryBeta := hedgeBeta
else if exitLong or exitShort
    pos := 0
    entryBar := na
    entryZ := na
    entryBeta := na

longSignal  = enterLong  and (not alertOnConfirm or barstate.isconfirmed)
shortSignal = enterShort and (not alertOnConfirm or barstate.isconfirmed)
exitSignal  = (exitLong or exitShort) and (not alertOnConfirm or barstate.isconfirmed)

exitReason =
     exitLongTP or exitShortTP ? "TAKE PROFIT"
  :  exitLongStop or exitShortStop ? "STOP OUT"
  :  timeExit ? "TIME EXIT"
  :  "—"

// Live trade status for dashboard (what to do RIGHT NOW)
tradeStatus =
     pos == 0 and enterLong ? "ENTER LONG PAIR NOW"
  :  pos == 0 and enterShort ? "ENTER SHORT PAIR NOW"
  :  pos == 1 and exitLongTP ? "TAKE PROFIT — close both legs"
  :  pos == 1 and exitLongStop ? "STOP OUT — close both legs"
  :  pos == -1 and exitShortTP ? "TAKE PROFIT — close both legs"
  :  pos == -1 and exitShortStop ? "STOP OUT — close both legs"
  :  pos != 0 and timeExit ? "TIME EXIT — close both legs"
  :  pos == 1 ? "HOLD LONG — wait for Z ≥ -" + str.tostring(zExit, "#.#") + " or stop"
  :  pos == -1 ? "HOLD SHORT — wait for Z ≤ +" + str.tostring(zExit, "#.#") + " or stop"
  :  not corrOk ? "NO TRADE — correlation FAIL"
  :  not hlOk ? "NO TRADE — half-life FAIL"
  :  longOnly ? "WAIT — need Z ≤ -" + str.tostring(zEntry, "#.#") + " + filters PASS"
  :  "WAIT — need |Z| ≥ " + str.tostring(zEntry, "#.#") + " + filters PASS"

statusCol =
     str.startswith(tradeStatus, "ENTER") or str.startswith(tradeStatus, "TAKE") ? color.new(#2e7d32, 0)
  :  str.startswith(tradeStatus, "STOP") or str.startswith(tradeStatus, "NO TRADE") ? color.new(#c62828, 0)
  :  str.startswith(tradeStatus, "TIME") ? color.new(#ef6c00, 0)
  :  str.startswith(tradeStatus, "HOLD") ? color.new(#1565c0, 0)
  :  color.new(#546e7a, 0)

passFail(bool ok) =>
    ok ? "PASS" : "FAIL"

passCol(bool ok) =>
    ok ? color.new(#2e7d32, 0) : color.new(#c62828, 0)

// ── Plots ────────────────────────────────────────────────────────────────────
zColor = zScore > zEntry ? color.new(#c62828, 0) : zScore < -zEntry ? color.new(#2e7d32, 0) : color.new(#546e7a, 0)

plot(showZPlot ? zScore : na, "Z-Score", color=zColor, linewidth=2)
hline(zEntry,  "Short Entry +Z", color=color.new(#c62828, 50), linestyle=hline.style_dashed)
hline(-zEntry, "Long Entry −Z",  color=color.new(#2e7d32, 30), linestyle=hline.style_dashed)
hline(zExit,   "TP +",  color=color.new(#ff8f00, 60), linestyle=hline.style_dotted)
hline(-zExit,  "TP −",  color=color.new(#ff8f00, 40), linestyle=hline.style_dotted)
hline(zStop,   "Stop +", color=color.new(#b71c1c, 40), linestyle=hline.style_solid)
hline(-zStop,  "Stop −", color=color.new(#b71c1c, 20), linestyle=hline.style_solid)
hline(0, "Zero", color=color.new(#90a4ae, 50))

plotshape(longSignal,  title="Long Pair",  style=shape.triangleup,   location=location.bottom, color=color.new(#2e7d32, 0), size=size.small, text="LONG\nPAIR")
plotshape(shortSignal, title="Short Pair", style=shape.triangledown, location=location.top,    color=color.new(#c62828, 0), size=size.small, text="SHORT\nPAIR")
plotshape(exitSignal,  title="Exit",       style=shape.circle,       location=location.bottom, color=color.new(#ff8f00, 0), size=size.tiny, text="EXIT")

bgcolor(pos == 1 ? color.new(#2e7d32, 92) : pos == -1 ? color.new(#c62828, 92) : na, title="In Trade")

// ── Live Trade Dashboard ─────────────────────────────────────────────────────
tableXY = tablePos == "Top Left" ? position.top_left : tablePos == "Top Right" ? position.top_right : tablePos == "Bottom Left" ? position.bottom_left : position.bottom_right
var table dash = table.new(tableXY, 2, 16, bgcolor=color.new(#1b1b1b, 5), border_width=1, border_color=color.new(#90a4ae, 50))

if showDash and barstate.islast
    // Header
    table.cell(dash, 0, 0, "LIVE TRADE COACH", text_color=color.white, text_size=size.small, bgcolor=color.new(#0d47a1, 0))
    table.cell(dash, 1, 0, syminfo.ticker + " × " + str.replace_all(pairSym, "NSE:", ""), text_color=color.white, text_size=size.small, bgcolor=color.new(#0d47a1, 0))

    // Big status — what to do now
    table.cell(dash, 0, 1, "TRADE STATUS", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 1, tradeStatus, text_color=color.white, text_size=size.tiny, bgcolor=color.new(statusCol, 70))

    // Current Z vs levels
    table.cell(dash, 0, 2, "Z-Score (live)", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(zScore, "#.###"), text_color=zColor, text_size=size.normal)

    table.cell(dash, 0, 3, "TP target Z", text_color=color.gray, text_size=size.tiny)
    tpTxt = pos == 1 ? "≥ -" + str.tostring(zExit, "#.#") : pos == -1 ? "≤ +" + str.tostring(zExit, "#.#") : "±" + str.tostring(zExit, "#.#")
    table.cell(dash, 1, 3, tpTxt, text_color=color.new(#ff8f00, 0), text_size=size.small)

    table.cell(dash, 0, 4, "Stop Z", text_color=color.gray, text_size=size.tiny)
    stTxt = pos == 1 ? "≤ -" + str.tostring(zStop, "#.#") : pos == -1 ? "≥ +" + str.tostring(zStop, "#.#") : "±" + str.tostring(zStop, "#.#")
    table.cell(dash, 1, 4, stTxt, text_color=color.new(#c62828, 0), text_size=size.small)

    table.cell(dash, 0, 5, "Bars Held / Max", text_color=color.gray, text_size=size.tiny)
    holdCol = timeExit ? color.new(#c62828, 0) : barsHeld >= maxHoldBars - 2 and pos != 0 ? color.new(#ef6c00, 0) : color.white
    table.cell(dash, 1, 5, str.tostring(barsHeld) + " / " + str.tostring(maxHoldBars), text_color=holdCol, text_size=size.small)

    // Entry checklist
    table.cell(dash, 0, 6, "── ENTRY CHECKS ──", text_color=color.new(#90a4ae, 0), text_size=size.tiny)
    table.cell(dash, 1, 6, longOnly ? "LONG-ONLY mode" : "LONG+SHORT mode", text_color=color.new(#90a4ae, 0), text_size=size.tiny)

    table.cell(dash, 0, 7, "Z ≤ -" + str.tostring(zEntry, "#.#") + " (long)", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 7, passFail(zLongOk) + "  (" + str.tostring(zScore, "#.##") + ")", text_color=passCol(zLongOk), text_size=size.small)

    table.cell(dash, 0, 8, "|Corr| ≥ " + str.tostring(minCorr, "#.##"), text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 8, passFail(corrOk) + "  (" + str.tostring(corr, "#.###") + ")", text_color=passCol(corrOk), text_size=size.small)

    table.cell(dash, 0, 9, "Half-Life ≤ " + str.tostring(maxHalfLife, "#.#"), text_color=color.gray, text_size=size.tiny)
    hlTxt = na(halfLife) ? "n/a" : str.tostring(halfLife, "#.1")
    table.cell(dash, 1, 9, passFail(hlOk) + "  (" + hlTxt + " bars)", text_color=passCol(hlOk), text_size=size.small)

    table.cell(dash, 0, 10, "All filters", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 10, passFail(entryFiltersOk), text_color=passCol(entryFiltersOk), text_size=size.small)

    // Position / hedge info
    table.cell(dash, 0, 11, "Position", text_color=color.gray, text_size=size.tiny)
    posLabel = pos == 1 ? "LONG PAIR" : pos == -1 ? "SHORT PAIR" : "FLAT"
    posCol = pos == 1 ? color.new(#2e7d32, 0) : pos == -1 ? color.new(#c62828, 0) : color.new(#546e7a, 0)
    table.cell(dash, 1, 11, posLabel, text_color=posCol, text_size=size.small)

    table.cell(dash, 0, 12, "Do this", text_color=color.gray, text_size=size.tiny)
    doTxt =
         pos == 1 ? "Hold: Long stock / Short Nifty"
      :  pos == -1 ? "Hold: Short stock / Long Nifty"
      :  enterLong ? "Buy stock / Short Nifty (β-sized)"
      :  enterShort ? "Short stock / Buy Nifty (β-sized)"
      :  "No position — wait for PASS checks"
    table.cell(dash, 1, 12, doTxt, text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 13, "Hedge β (size Nifty)", text_color=color.gray, text_size=size.tiny)
    betaShow = pos != 0 and not na(entryBeta) ? entryBeta : hedgeBeta
    table.cell(dash, 1, 13, str.tostring(betaShow, "#.####") + " × stock notional", text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 14, "Entry Z (this trade)", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 14, na(entryZ) ? "—" : str.tostring(entryZ, "#.###"), text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 15, "How to read", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 15, "Watch TRADE STATUS daily. Green PASS = ok to enter. In trade: exit on TP/STOP/TIME.", text_color=color.new(#b0bec5, 0), text_size=size.tiny)

// ── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(longSignal, title="Enter Long Pair", message="ENTER LONG PAIR — Buy stock / Short Nifty. Filters PASS.")
alertcondition(shortSignal, title="Enter Short Pair", message="ENTER SHORT PAIR — Short stock / Buy Nifty.")
alertcondition(exitSignal and (exitLongTP or exitShortTP), title="Take Profit", message="TAKE PROFIT — Z mean-reverted. Close both legs.")
alertcondition(exitSignal and (exitLongStop or exitShortStop), title="Stop Out", message="STOP OUT — Z hit stop. Close both legs.")
alertcondition(exitSignal and timeExit, title="Time Exit", message="TIME EXIT — max hold reached. Close both legs.")
alertcondition(entryFiltersOk and zLongOk, title="Long Setup Ready", message="Long setup filters PASS and Z at entry.")

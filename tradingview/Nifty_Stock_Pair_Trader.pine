//@version=5
indicator("Nifty × Stock Pair Trader Pro", shorttitle="Nifty Pair Pro", overlay=false, max_bars_back=5000, precision=4)

// =============================================================================
// NIFTY × STOCK PAIR TRADER PRO
// -----------------------------------------------------------------------------
// Desk-style statistical arbitrage toolkit, simplified for TradingView:
//   • Rolling OLS hedge ratio (Engle–Granger residual style)
//   • Optional Kalman-filter dynamic beta
//   • Log / price / ratio spreads
//   • Z-score mean-reversion entries & exits
//   • Rolling correlation regime filter
//   • Ornstein–Uhlenbeck half-life (holding-period guide)
//   • Spread percentile & Bollinger context
//   • Simple LONG PAIR / SHORT PAIR signals + dashboard
//
// HOW TO USE (Indian markets)
//   1. Open the STOCK chart (e.g. NSE:RELIANCE, NSE:TCS, NSE:INFY)
//   2. Add this indicator
//   3. Set Pair Symbol to NSE:NIFTY (or NSE:CNX500 / sector index)
//   4. Trade when Z-Score crosses Entry levels AND Correlation is OK
// =============================================================================

// ── Inputs (kept minimal) ────────────────────────────────────────────────────
grpCore   = "1) Pair Setup"
pairSym   = input.symbol("NSE:NIFTY", "Pair Symbol (Nifty / Index)", group=grpCore, tooltip="Chart = stock. This = hedge leg (usually Nifty). Use NSE:NIFTY or a sector index.")
spreadMode = input.string("Residual (OLS)", "Spread Model", options=["Residual (OLS)", "Log Residual (OLS)", "Price Ratio", "Log Ratio"], group=grpCore, tooltip="Residual (OLS) is the classic prop-desk Engle–Granger residual. Log Residual is scale-invariant.")
betaMode  = input.string("Rolling OLS", "Hedge Ratio", options=["Rolling OLS", "Kalman Filter", "Fixed 1.0"], group=grpCore, tooltip="Rolling OLS = standard. Kalman = adaptive beta (useful in regime shifts).")
lookback  = input.int(60, "Lookback (bars)", minval=20, maxval=500, group=grpCore, tooltip="Window for beta, mean, std, correlation. Intraday: 60–120. Daily: 60–120.")

grpSig    = "2) Signals (Z-Score)"
zEntry    = input.float(2.0, "Entry |Z|", minval=0.5, maxval=5.0, step=0.1, group=grpSig, tooltip="Enter when |Z| ≥ this. Classic: 2.0")
zExit     = input.float(0.5, "Exit |Z|",  minval=0.0, maxval=3.0, step=0.1, group=grpSig, tooltip="Exit / take profit when |Z| falls to this. Classic: 0.0–0.5")
zStop     = input.float(3.5, "Stop |Z|",  minval=1.0, maxval=8.0, step=0.1, group=grpSig, tooltip="Hard stop if divergence worsens beyond this.")
useCorrFilter = input.bool(true, "Require Correlation Filter", group=grpSig)
minCorr   = input.float(0.70, "Min |Correlation|", minval=0.0, maxval=0.99, step=0.05, group=grpSig, tooltip="Skip trades when the pair is not co-moving enough.")

grpAdv    = "3) Advanced (optional)"
kalmanQ   = input.float(0.0001, "Kalman Process Noise (Q)", minval=0.000001, maxval=0.01, step=0.0001, group=grpAdv, tooltip="Higher Q = beta adapts faster.")
kalmanR   = input.float(0.01, "Kalman Measurement Noise (R)", minval=0.0001, maxval=1.0, step=0.001, group=grpAdv)
useLogPrices = input.bool(false, "Force Log Prices for OLS/Kalman", group=grpAdv, tooltip="Usually leave OFF; Log Residual mode already logs prices.")
showBands = input.bool(true, "Show Spread Bollinger", group=grpAdv)
bbMult    = input.float(2.0, "Bollinger Mult", minval=0.5, maxval=4.0, step=0.1, group=grpAdv)
showHl    = input.bool(true, "Show Half-Life in Table", group=grpAdv)
alertOnConfirm = input.bool(true, "Alerts Need Bar Close", group=grpAdv)

grpVis    = "4) Display"
showZPlot = input.bool(true, "Show Z-Score", group=grpVis)
showSprPlot = input.bool(false, "Also Plot Raw Spread (same pane)", group=grpVis, tooltip="Leave OFF for a clean Z-score view. Turn ON only if you want the raw residual/ratio overlaid.")
showDash  = input.bool(true, "Show Dashboard", group=grpVis)
tablePos  = input.string("Top Right", "Dashboard Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=grpVis)

// ── Data ─────────────────────────────────────────────────────────────────────
stockClose = close
pairClose  = request.security(pairSym, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)

stockPx = useLogPrices or str.contains(spreadMode, "Log") ? math.log(math.max(stockClose, 1e-10)) : stockClose
pairPx  = useLogPrices or str.contains(spreadMode, "Log") ? math.log(math.max(pairClose, 1e-10))  : pairClose

// ── Rolling OLS beta: stock ~ alpha + beta * pair ────────────────────────────
// beta = Cov(y,x) / Var(x)
f_ols_beta(float y, float x, int len) =>
    meanY = ta.sma(y, len)
    meanX = ta.sma(x, len)
    covXY = ta.sma(y * x, len) - meanY * meanX
    varX  = ta.sma(x * x, len) - meanX * meanX
    varX > 1e-12 ? covXY / varX : 1.0

f_ols_alpha(float y, float x, float beta, int len) =>
    ta.sma(y, len) - beta * ta.sma(x, len)

olsBeta  = f_ols_beta(stockPx, pairPx, lookback)
olsAlpha = f_ols_alpha(stockPx, pairPx, olsBeta, lookback)

// ── Kalman filter (1D state = beta), classic adaptive hedge ratio ────────────
// Measurement: stock ≈ beta * pair  (alpha absorbed into residual mean later)
var float kfBeta = 1.0
var float kfP    = 1.0
if barstate.isfirst
    kfBeta := 1.0
    kfP    := 1.0
else
    // Predict
    betaPred = kfBeta
    pPred    = kfP + kalmanQ
    // Update
    x = pairPx
    y = stockPx
    // S = x*P*x + R
    S = x * x * pPred + kalmanR
    K = S > 0 ? (pPred * x) / S : 0.0
    innov = y - betaPred * x
    kfBeta := betaPred + K * innov
    kfP    := (1.0 - K * x) * pPred

// ── Selected hedge ratio ─────────────────────────────────────────────────────
hedgeBeta = betaMode == "Kalman Filter" ? kfBeta : betaMode == "Fixed 1.0" ? 1.0 : olsBeta
hedgeAlpha = betaMode == "Rolling OLS" ? olsAlpha : 0.0

// ── Spread construction ──────────────────────────────────────────────────────
spread = switch spreadMode
    "Residual (OLS)"     => stockClose - (hedgeAlpha + hedgeBeta * pairClose)
    "Log Residual (OLS)" => stockPx - (hedgeAlpha + hedgeBeta * pairPx)
    "Price Ratio"        => stockClose / math.max(pairClose, 1e-10)
    "Log Ratio"          => math.log(math.max(stockClose, 1e-10) / math.max(pairClose, 1e-10))
    => stockClose - hedgeBeta * pairClose

spreadMean = ta.sma(spread, lookback)
spreadStd  = ta.stdev(spread, lookback)
zScore     = spreadStd > 1e-12 ? (spread - spreadMean) / spreadStd : 0.0

// Bollinger on spread (visual context)
bbMid = spreadMean
bbUpper = spreadMean + bbMult * spreadStd
bbLower = spreadMean - bbMult * spreadStd

// Percentile of current spread in lookback window (0–100)
f_percentile_rank(float src, int len) =>
    float rank = 0.0
    for i = 0 to len - 1
        rank += src >= src[i] ? 1.0 : 0.0
    100.0 * rank / len

spreadPct = f_percentile_rank(spread, lookback)

// ── Correlation (Pearson, rolling) ───────────────────────────────────────────
corr = ta.correlation(stockClose, pairClose, lookback)
corrOk = not useCorrFilter or math.abs(corr) >= minCorr

// ── Half-life of mean reversion (Ornstein–Uhlenbeck / AR(1) on demeaned spread)
// spread_t - mean ≈ φ * (spread_{t-1} - mean) + ε
// half-life = -ln(2) / ln(φ)   when 0 < φ < 1
f_half_life(float spr, float mean, int len) =>
    float ySum = 0.0
    float xSum = 0.0
    float xxSum = 0.0
    float xySum = 0.0
    int n = 0
    for i = 0 to len - 2
        float x = spr[i + 1] - mean
        float y = spr[i] - mean
        xSum  += x
        ySum  += y
        xxSum += x * x
        xySum += x * y
        n += 1
    float denom = n * xxSum - xSum * xSum
    float phi = denom != 0 ? (n * xySum - xSum * ySum) / denom : 0.0
    float hl = (phi > 0 and phi < 1) ? -math.log(2.0) / math.log(phi) : na
    hl

halfLife = showHl ? f_half_life(spread, spreadMean, lookback) : na

// Rough “tradeable” quality: mean-reverting + correlated
pairQuality = corrOk and not na(halfLife) and halfLife > 0 and halfLife < lookback * 1.5

// ── Signal state machine ─────────────────────────────────────────────────────
// LONG PAIR  = long stock, short Nifty   when stock is cheap vs hedge (Z low)
// SHORT PAIR = short stock, long Nifty   when stock is rich vs hedge (Z high)
var int pos = 0   // 1 long pair, -1 short pair, 0 flat

enterLong  = corrOk and zScore <= -zEntry and pos <= 0
enterShort = corrOk and zScore >=  zEntry and pos >= 0
exitLong   = pos == 1  and (zScore >= -zExit or zScore <= -zStop)
exitShort  = pos == -1 and (zScore <=  zExit or zScore >=  zStop)

if enterLong
    pos := 1
else if enterShort
    pos := -1
else if exitLong or exitShort
    pos := 0

// Confirmed (closed-bar) versions for alerts
longSignal   = enterLong  and (not alertOnConfirm or barstate.isconfirmed)
shortSignal  = enterShort and (not alertOnConfirm or barstate.isconfirmed)
exitSignal   = (exitLong or exitShort) and (not alertOnConfirm or barstate.isconfirmed)

// ── Plots ────────────────────────────────────────────────────────────────────
zColor = zScore > zEntry ? color.new(#c62828, 0) : zScore < -zEntry ? color.new(#2e7d32, 0) : color.new(#546e7a, 0)

plot(showZPlot ? zScore : na, "Z-Score", color=zColor, linewidth=2)
hline(zEntry,  "Entry +", color=color.new(#c62828, 40), linestyle=hline.style_dashed)
hline(-zEntry, "Entry −", color=color.new(#2e7d32, 40), linestyle=hline.style_dashed)
hline(zExit,   "Exit +",  color=color.new(#ff8f00, 60), linestyle=hline.style_dotted)
hline(-zExit,  "Exit −",  color=color.new(#ff8f00, 60), linestyle=hline.style_dotted)
hline(zStop,   "Stop +",  color=color.new(#b71c1c, 30), linestyle=hline.style_solid)
hline(-zStop,  "Stop −",  color=color.new(#1b5e20, 30), linestyle=hline.style_solid)
hline(0, "Zero", color=color.new(#90a4ae, 50))

// Soft fill between ± entry
fill(plot(showZPlot ? zEntry : na, display=display.none), plot(showZPlot ? -zEntry : na, display=display.none), color=color.new(#90a4ae, 92), title="Neutral Zone")

plot(showSprPlot ? spread : na, "Spread", color=color.new(#1565c0, 0), linewidth=1, display=display.pane)
plot(showSprPlot and showBands ? bbUpper : na, "Spread BB Upper", color=color.new(#1565c0, 70), display=display.pane)
plot(showSprPlot and showBands ? bbMid   : na, "Spread BB Mid",   color=color.new(#1565c0, 80), style=plot.style_line, display=display.pane)
plot(showSprPlot and showBands ? bbLower : na, "Spread BB Lower", color=color.new(#1565c0, 70), display=display.pane)

plotshape(longSignal,  title="Long Pair",  style=shape.triangleup,   location=location.bottom, color=color.new(#2e7d32, 0), size=size.small, text="LONG\nPAIR")
plotshape(shortSignal, title="Short Pair", style=shape.triangledown, location=location.top,    color=color.new(#c62828, 0), size=size.small, text="SHORT\nPAIR")
plotshape(exitSignal,  title="Exit",       style=shape.circle,       location=location.bottom, color=color.new(#ff8f00, 0), size=size.tiny, text="EXIT")

bgcolor(pos == 1 ? color.new(#2e7d32, 92) : pos == -1 ? color.new(#c62828, 92) : na, title="Position Tint")

// ── Dashboard ────────────────────────────────────────────────────────────────
posLabel = pos == 1 ? "LONG PAIR" : pos == -1 ? "SHORT PAIR" : "FLAT"
posCol   = pos == 1 ? color.new(#2e7d32, 0) : pos == -1 ? color.new(#c62828, 0) : color.new(#546e7a, 0)
actionHint =
     pos == 0 and zScore <= -zEntry and corrOk ? "Buy Stock / Short Nifty"
  :  pos == 0 and zScore >=  zEntry and corrOk ? "Short Stock / Buy Nifty"
  :  pos == 1 ? "Holding: Long Stock / Short Nifty"
  :  pos == -1 ? "Holding: Short Stock / Long Nifty"
  :  not corrOk ? "Wait — correlation weak"
  :  "Wait for |Z| ≥ " + str.tostring(zEntry, "#.#")

qualTxt = pairQuality ? "GOOD" : corrOk ? "OK" : "WEAK"
qualCol = pairQuality ? color.new(#2e7d32, 0) : corrOk ? color.new(#ff8f00, 0) : color.new(#c62828, 0)

tableXY = tablePos == "Top Left" ? position.top_left : tablePos == "Top Right" ? position.top_right : tablePos == "Bottom Left" ? position.bottom_left : position.bottom_right

var table dash = table.new(tableXY, 2, 12, bgcolor=color.new(#263238, 8), border_width=1, border_color=color.new(#90a4ae, 60))

if showDash and barstate.islast
    table.cell(dash, 0, 0, "Nifty Pair Pro", text_color=color.white, text_size=size.small, bgcolor=color.new(#1565c0, 0))
    table.cell(dash, 1, 0, syminfo.ticker + " × " + str.replace_all(pairSym, "NSE:", ""), text_color=color.white, text_size=size.small, bgcolor=color.new(#1565c0, 0))

    table.cell(dash, 0, 1, "Position", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 1, posLabel, text_color=posCol, text_size=size.small)

    table.cell(dash, 0, 2, "Action", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 2, actionHint, text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 3, "Z-Score", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 3, str.tostring(zScore, "#.###"), text_color=zColor, text_size=size.small)

    table.cell(dash, 0, 4, "Hedge β", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(hedgeBeta, "#.####") + " (" + betaMode + ")", text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 5, "Correlation", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 5, str.tostring(corr, "#.###"), text_color=corrOk ? color.new(#2e7d32, 0) : color.new(#c62828, 0), text_size=size.small)

    table.cell(dash, 0, 6, "Spread %ile", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 6, str.tostring(spreadPct, "#.0") + "%", text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 7, "Half-Life", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 7, na(halfLife) ? "n/a" : str.tostring(halfLife, "#.1") + " bars", text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 8, "Pair Quality", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 8, qualTxt, text_color=qualCol, text_size=size.small)

    table.cell(dash, 0, 9, "Entry / Exit / Stop", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 9, str.tostring(zEntry, "#.#") + " / " + str.tostring(zExit, "#.#") + " / " + str.tostring(zStop, "#.#"), text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 10, "Model", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 10, spreadMode, text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 11, "Lookback", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 11, str.tostring(lookback) + " bars", text_color=color.white, text_size=size.tiny)

// ── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(longSignal,  title="Long Pair",  message="LONG PAIR: Buy stock / Short Nifty — Z oversold vs hedge")
alertcondition(shortSignal, title="Short Pair", message="SHORT PAIR: Short stock / Buy Nifty — Z overbought vs hedge")
alertcondition(exitSignal,  title="Exit Pair",  message="EXIT pair trade — Z mean-reverted or stop hit")
alertcondition(corrOk and math.abs(zScore) >= zEntry, title="Z Entry Level", message="Z-Score reached entry threshold")
